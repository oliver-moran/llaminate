{
  "name": "llaminate",
  "version": "0.2.4",
  "description": "A simple but powerful library that abstracts LLM chat completions, providing chat history, tokens tracking and tools interfaces.",
  "repository": "github:oliver-moran/llaminate",
  "homepage": "https://oliver-moran.github.io/llaminate/",
  "bugs": {
    "url": "https://github.com/oliver-moran/llaminate/issues"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "llaminate": "./dist/cli/llaminate.min.js"
  },
  "main": "dist/llaminate.min.js",
  "types": "dist/llaminate.d.ts",
  "exports": {
    ".": {
      "types": "./dist/llaminate.d.ts",
      "require": "./dist/llaminate.min.js",
      "default": "./dist/llaminate.min.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "require": "./dist/chat.min.js",
      "default": "./dist/chat.min.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "require": "./dist/tools/index.min.js",
      "default": "./dist/tools/index.min.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "build": "bash scripts/build.sh",
    "docs": "bash scripts/docs.sh",
    "prepare": "bash scripts/prepare.sh",
    "pretest": "node scripts/pretest.js",
    "scratch": "node --env-file=.env ./tests/scratch.js",
    "test": "jest --i --config=./tests/jest.config.json",
    "cli": "node dist/cli/llaminate.min.js"
  },
  "keywords": [
    "LLM",
    "AI",
    "chat",
    "completions",
    "streaming",
    "tools"
  ],
  "author": "Oliver Moran <oliver.moran@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.55.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "jsdoc": "^4.0.5",
    "terser": "^5.46.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.18.0",
    "dompurify": "^3.4.7",
    "handlebars": "^4.7.8",
    "ink": "^7.0.5",
    "js-yaml": "^4.2.0",
    "jsdom": "^29.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.7"
  }
}
